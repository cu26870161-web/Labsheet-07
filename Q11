#include <iostream>
#include <cstring>
using namespace std;

int main() {
    char str[100], original[100];

    cout << "Enter a string: ";
    cin.getline(str, 100);

    strcpy(original, str);
    strrev(str);

    if (strcmp(original, str) == 0)
        cout << "String is palindrome";
    else
        cout << "String is not palindrome";

    return 0;
}
