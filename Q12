#include <iostream>
#include <string>
using namespace std;

int main() {
    char str[100], ch;
    char *position;

    cout << "Enter a string: ";
    cin.getline(str, 100);

    cout << "Enter character to find: ";
    cin >> ch;

    position = strchr(str, ch);

    if (position != NULL)
        cout << "Character found at position "
             << position - str + 1;
    else
        cout << "Character not found";

    return 0;
}
