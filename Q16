#include <iostream>
#include <cstring>
#include <cctype>
using namespace std;

int main() {
    char str[200];
    int words = 0;

    cout << "Enter a sentence: ";
    cin.getline(str, 200);

    for (int i = 0; i < strlen(str); i++) {
        if (!isspace((unsigned char)str[i]) &&
            (i == 0 || isspace((unsigned char)str[i - 1]))) {
            words++;
        }
    }

    cout << "Number of words = " << words;

    return 0;
}
